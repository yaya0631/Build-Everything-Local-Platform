{
  "name": "teamchat",
  "version": "1.0.0",
  "description": "Team messaging on Everything: workspaces, channels, threads, and direct messages",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run build:worker && vite",
    "build": "npm run build:worker && vite build",
    "build:app": "vite build",
    "build:icons": "node scripts/build-icons.mjs",
    "build:worker": "vite build --config vite.worker.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaya0631/Build-Everything-Local-Platform"
  },
  "devDependencies": {
    "vite": "^8.2.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "lucide": "^1.28.0"
  }
}
