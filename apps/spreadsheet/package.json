{
  "name": "spreadsheet",
  "version": "1.0.0",
  "description": "A fast, private spreadsheet app on Everything: formulas, formatting, and .xlsx files in your own cloud",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:worker && vite build",
    "preview": "vite preview",
    "icons": "sh dev/generate-icons.sh",
    "template:thumbnails": "node dev/generate-template-thumbnails.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:worker": "vite build --config vite.worker.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaya0631/Build-Everything-Local-Platform"
  },
  "bugs": {
    "url": "https://github.com/yaya0631/Build-Everything-Local-Platform"
  },
  "homepage": "https://github.com/yaya0631/Build-Everything-Local-Platform",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@xmldom/xmldom": "0.9.12",
    "lucide": "^1.28.0"
  },
  "devDependencies": {
    "jsdom": "^27.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
