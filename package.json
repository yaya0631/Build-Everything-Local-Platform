{
  "name": "everything-local",
  "version": "1.0.0",
  "private": true,
  "description": "Everything Local — the Everything app suite running entirely on a local Node server.",
  "type": "module",
  "workspaces": [
    "platform",
    "apps/*"
  ],
  "scripts": {
    "dev": "node platform/server/index.js",
    "build": "node platform/server/index.js --build",
    "start": "node platform/server/index.js",
    "test": "node --test platform/platform.test.js",
    "postinstall": "patch-package --patch-dir apps/presentation/patches --error-on-fail"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "patch-package": "8.0.1"
  }
}
